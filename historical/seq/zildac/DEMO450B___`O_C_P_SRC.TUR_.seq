;``````````À````````````````````````````;'INSIGHT Q&A' COLUMN JULY, 1991 ISSUE;;ADV. OPC MULTICOLOR HI-RES DISPLAYER;BY GUARDIAN (Q&A COLUMN);;ASSEMBLER: TURBO ASSEMBLER 5.01;COMPUTER : C64 (OR C128 IN 64 MODE.);```````````````````````````````````````         *= $1000         SEI         LDX #$00        ;COPYLOOP     LDA $4338,X     ;COLOR DATA         STA $D800,X     ;TO COLOR RAM         LDA $4438,X     ;($D800-$DBFF)         STA $D900,X         LDA $4538,X         STA $DA00,X         LDA $4638,X         STA $DB00,X         LDA $3F40,X     ;COPY COLOR         STA $0400,X     ;DATA TO         LDA $4040,X     ;SCREEN RAM         STA $0500,X     ;($0400-$07FF)         LDA $4140,X         STA $0600,X         LDA $4240,X         STA $0700,X         INX         BNE LOOP         LDA $4329       ;BACKGROUND         STA $D021       ;COLOR DATA         LDA #$3B        ;ENTER MULTI-         STA $D011       ;-COLOR HI-RES         LDA #$D8        ;MODE.         STA $D016         LDA #$18         STA $D018MAINLP   JMP MAINLP