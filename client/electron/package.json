{
  "name": "compunet-reborn-desktop",
  "productName": "Compunet Reborn",
  "version": "1.2.1",
  "private": true,
  "description": "Compunet Reborn desktop client (Electron shell around the web client)",
  "main": "main.js",
  "scripts": {
    "_comment": "⚠ Every script that PACKAGES or RUNS the app rebuilds the web client first. The shell only COPIES ../web/dist/app.bundle.js, so without this it silently ships whatever bundle happened to be on disk — it builds fine, launches fine, and runs stale code. That shipped once: an installer went out carrying a bundle four commits old, and the symptom (an old behaviour surviving a fix) reads as the fix not working.",
    "build:web": "npm --prefix ../web run build",
    "start": "npm run build:web && electron .",
    "pack:win": "npm run build:web && electron-builder --win --dir",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "live.compunet.reborn",
    "productName": "Compunet Reborn",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "app/web",
        "filter": [
          "index.html",
          "assets.json",
          "dist/app.bundle.js"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage"
    },
    "portable": {
      "artifactName": "Compunet Reborn ${version} (portable).exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
