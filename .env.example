# Compunet Reborn Configuration
# Copy this file to .env and set your values.
#
# Read by the website (website/config.py) and by the server
# (compunet_server.py, which prefers server/.env and falls back to this one).
# Under Docker both containers mount it at /app/.env, so one file serves both.
#
# ⚠ Values are used verbatim: no quotes, and no spaces around `=`. server.sh and
# website.sh `source` this file, so a quoted value keeps its quotes in Python
# while an unquoted value containing spaces breaks bash. On Windows, save it as
# UTF-8 WITHOUT a byte-order mark — bash cannot source a file that has one.
#
# Settings shown commented out are optional: the value given is the default, and
# uncommenting is only needed to override it.


# ─── Shared: server and website ────────────────────────────────────────────

# API key for the user management REST API (shared between server and website).
# ⚠ Both sides must match, and it FAILS CLOSED: with this unset the server
# rejects every website request with 401, which looks like a working site whose
# registration, admin panel and password reset are all broken.
COMPUNET_API_KEY=changeme

# Postmark server token (handles both transactional and broadcast streams)
# Transactional: uses "outbound" stream (default)
# Broadcasts: uses "broadcast" stream
POSTMARK_API_KEY=changeme

# From address for outgoing emails
EMAIL_FROM=noreply@compunet.live


# ─── Website ───────────────────────────────────────────────────────────────

# Flask secret key for session cookies
WEBSITE_SECRET_KEY=changeme

# Public URL of the website (used in verification and password-reset links)
WEBSITE_BASE_URL=https://dev.compunet.live

# Where the website sends people for the web client — the address the client API
# (port 6404) is published at.
# ⚠ Unset, the Connect page silently OMITS the browser option altogether, which
# is correct for a deployment that hosts no client but looks like a missing
# feature otherwise. Production uses https://connect.compunet.live;
# docker-compose.yml sets this per-deployment and overrides the value here.
COMPUNET_CLIENT_URL=http://localhost:6404

# The server's admin REST API (port 6403). The default suits a server on the
# same machine; docker-compose.yml sets the on-network name instead.
#COMPUNET_API_URL=http://localhost:6403

# WebSocket endpoint for the admin partyline page. Derived from COMPUNET_API_URL
# when unset (http->ws, https->wss, plus /ws/partyline); set it only when the
# WebSocket is reached at a different address than the REST API.
#PARTYLINE_WS_URL=


# ─── Server ────────────────────────────────────────────────────────────────

# The reference web client, served from the client API's own origin so the
# browser client has no CORS to deal with. The default is correct under Docker,
# where the Dockerfile copies the client to /app/web. In a SOURCE CHECKOUT that
# directory does not exist and port 6404 answers the API but 404s on `/`, so
# point this at the built client — relative to server/, and note it must not
# contain spaces (see the warning above).
#COMPUNET_WEB_CLIENT_DIR=../client/web

# Content and runtime data. COMPUNET_DATA_DIR moves everything together, which
# is what a validation run against the fixture tree wants — see
# docs/spec/CLEANROOM.md. The other two override individual paths beneath it.
#COMPUNET_DATA_DIR=server/data
#COMPUNET_CONTENT_DIR=server/data/content
#COMPUNET_MAIL_DIR=server/data/mail

# Origin allowed to call the client API (Binding B). Defaults to any origin;
# pin it to one to narrow the surface.
#CLIENT_API_CORS_ORIGIN=*

# Logging verbosity. DEBUG restores full protocol tracing.
#LOG_LEVEL=INFO

# Port for run_api_only.py — the client API with NO static file serving, used
# for clean-room validation so an isolated client builder gets the protocol and
# cannot fetch our own implementation (see docs/spec/CLEANROOM.md).
#CLIENT_API_PORT=6414
